@startuml garanty_activity
' Проект «Гаранты»: диаграмма деятельности суточного цикла (строгий UML)
' Рендер: plantuml.com или расширение PlantUML в VS Code
skinparam shadowing false
title Гаранты — ежедневный цикл: правовые шлюзы перед аналитикой

start
:Триггер (суточный запуск или событие ПКБ);
:Обновить данные уровня 1;
:Пересчитать legal_ceiling и guarantee_alive;

if (Обеспечение действует? (ст. 336, сроки)) then (нет)
  :Закрыть дело — обеспечение прекращено;
  stop
else (да)
endif

if (Тип ответственности) then (поручительство — субсидиарно)
  if (К должнику обратились? (ст. 357)) then (нет)
    :Ждать — сначала должник;
    stop
  else (да)
  endif
else (гарантия — солидарно, ст. 329)
endif

:Построить портрет гаранта;
:Оценить expected_recovery, realisable_assets, dissipation_risk;

switch (Сегмент)
case (может и будет)
  :Стандартный трек требования;
  :Досудебное уведомление (10 / 30 / 15 дней);
  if (Урегулировано?) then (да)
    :План погашения на контроле;
    stop
  else (нет)
    :Судебный приказ (3 р.д.) или иск;
  endif
case (не может платить)
  :Реструктуризация или списание;
  stop
case (пустая оболочка)
  :Проверить признаки вывода;
case (может, но прячет)
  :Антифрод-трек: алерт + запрос обеспечительных мер;
endswitch

:Исполнительное производство (ЧСИ, уровень 2);
stop
@enduml
